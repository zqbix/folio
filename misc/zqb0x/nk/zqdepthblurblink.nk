 BlinkScript {
  inputs 3
  recompileCount 3
  ProgramGroup 1
  KernelDescription "3 \"Bokeh\" iterate pixelWise 9c0182e5886a8869cae4d6b226ce1469e9c090724475b9988b91151c572a815a 4 \"src\" Read Ranged2D \"mask\" Read Point \"bokeh\" Read Random \"dst\" Write Point 7 \"maxRadius\" Float 1 AAAgQQ== \"quality\" Int 1 BQAAAA== \"chromaStrength\" Float 1 AAAAAA== \"chromaRadius\" Float 1 AAAAAA== \"chromaShift\" Float 1 AAAAAA== \"bokehResolution\" Int 1 AAIAAA== \"adaptiveQuality\" Int 1 AAAAAA== 7 \"maxRadius\" 1 1 Default \"quality\" 1 1 Default \"chromaStrength\" 1 1 Default \"chromaRadius\" 1 1 Default \"chromaShift\" 1 1 Default \"bokehResolution\" 1 1 Default \"adaptiveQuality\" 1 1 Default 12 \"srcrangeMin\" Int 2 1 AAAAAAAAAAA= \"srcrangeMax\" Int 2 1 AAAAAAAAAAA= \"maxRadiusInt\" Int 1 1 AAAAAA== \"bokehMaxIndex\" Float 1 1 AAAAAA== \"complexPass\" Bool 1 1 AA== \"chromaStrengthSafe\" Float 1 1 AAAAAA== \"chromaRadiusSafe\" Float 1 1 AAAAAA== \"chromaShiftSafe\" Float 1 1 AAAAAA== \"radiusScaleR\" Float 1 1 AAAAAA== \"radiusScaleB\" Float 1 1 AAAAAA== \"TWO_PI\" Float 1 1 AAAAAA== \"GOLDEN_ANGLE\" Float 1 1 AAAAAA=="
  kernelSource "kernel Bokeh : public ImageComputationKernel<ePixelWise>\n\{ \n  // Input / Output Images\n  Image<eRead, eAccessRanged2D, eEdgeClamped> src; \n  Image<eRead, eAccessPoint, eEdgeClamped> mask; \n  Image<eRead, eAccessRandom, eEdgeClamped> bokeh; \n  Image<eWrite> dst; \n\n  // Public Parameters\n  param:\n    float maxRadius; \n    int quality; \n    float chromaStrength; \n    float chromaRadius; \n    float chromaShift; \n    int bokehResolution; \n    int adaptiveQuality; \n\n  // Local Variables\n  local:\n    int maxRadiusInt; \n    float bokehMaxIndex; \n    bool complexPass; \n    float chromaStrengthSafe; \n    float chromaRadiusSafe; \n    float chromaShiftSafe; \n    float radiusScaleR; \n    float radiusScaleB; \n    float TWO_PI; \n    float GOLDEN_ANGLE; \n\n  inline float4 sanitizeVec(float4 v) \{\n    if (v.x != v.x || fabs(v.x) > 1.0e30f) v.x = 0.0f;\n    if (v.y != v.y || fabs(v.y) > 1.0e30f) v.y = 0.0f;\n    if (v.z != v.z || fabs(v.z) > 1.0e30f) v.z = 0.0f;\n    if (v.w != v.w || fabs(v.w) > 1.0e30f) v.w = 0.0f;\n    return v;\n  \}\n\n  void define() \n  \{ \n    defineParam(maxRadius, \"maxRadius\", 10.0f); \n    defineParam(quality, \"quality\", 5); \n    defineParam(chromaStrength, \"chromaStrength\", 0.0f); \n    defineParam(chromaRadius, \"chromaRadius\", 0.0f); \n    defineParam(chromaShift, \"chromaShift\", 0.0f); \n    defineParam(bokehResolution, \"bokehResolution\", 512); \n    defineParam(adaptiveQuality, \"adaptiveQuality\", 0); \n  \} \n\n  void init() \n  \{ \n    TWO_PI = 6.2831853f; \n    GOLDEN_ANGLE = 2.3999632f; \n\n    float safeRadius = max(maxRadius, 0.0f); \n    chromaRadiusSafe = clamp(chromaRadius, -0.5f, 0.5f); \n    chromaShiftSafe = clamp(chromaShift, -0.25f, 0.25f); \n    chromaStrengthSafe = clamp(chromaStrength, 0.0f, 16.0f); \n\n    radiusScaleR = max(0.01f, 1.0f + chromaRadiusSafe); \n    radiusScaleB = max(0.01f, 1.0f - chromaRadiusSafe); \n\n    // CRITICAL BUG FIX: Ensure memory mapping footprints contain combined shift limits\n    float maxRadiusScale = 1.0f + fabs(chromaRadiusSafe) + fabs(chromaShiftSafe); \n    float maxChromaticRadius = safeRadius * maxRadiusScale + 3.0f; \n    maxRadiusInt = int(ceil(maxChromaticRadius)) + 1; \n\n    src.setRange(-maxRadiusInt, -maxRadiusInt, maxRadiusInt, maxRadiusInt); \n\n    int safeBokehResolution = max(bokehResolution, 2); \n    bokehMaxIndex = float(safeBokehResolution - 1); \n\n    // Unified operational state flag\n    complexPass = (fabs(chromaRadiusSafe) > 0.000001f || fabs(chromaShiftSafe) > 0.000001f); \n  \} \n\n  void process(int2 pos) \n  \{ \n    float m = clamp(mask().x, 0.0f, 1.0f); \n    float radius = max(maxRadius, 0.0f) * m; \n\n    if (radius < 0.5f) \{ \n      dst() = src(0, 0); \n      return; \n    \} \n\n    int rings = clamp(quality, 1, 160); \n    if (adaptiveQuality != 0) \{ \n      rings = max(int(round(float(rings) * m)), 1); \n    \} \n\n    float radiusR = radius * radiusScaleR; \n    float radiusB = radius * radiusScaleB; \n\n    float4 sumVec = sanitizeVec(src(0, 0)); \n    float4 weightVec = float4(1.0f, 1.0f, 1.0f, 1.0f); \n\n    // TRIPLE-CHECKED OPTIMIZATION: High-level branching hoists calculations out of execution frames\n    if (!complexPass) \{ \n      // Simple Pass: Zero Chromatic Aberration / Dispersion artifacts\n      for (int r = 1; r <= rings; ++r) \{ \n        float normalizedRadius = sqrt((float(r) - 0.5f) / float(rings)); \n        float currentRadius = radius * normalizedRadius; \n\n        int angularSamples = clamp(int(ceil(TWO_PI * currentRadius)), 8, 512); \n        float invAngularSamples = 1.0f / float(angularSamples); \n        float ringRotation = float(r) * GOLDEN_ANGLE; \n\n        for (int a = 0; a < angularSamples; ++a) \{ \n          float angle = (float(a) + 0.5f) * invAngularSamples * TWO_PI + ringRotation; \n          float c = cos(angle); \n          float s = sin(angle); \n\n          float bxRaw = clamp(((c * normalizedRadius) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex);\n          float byRaw = clamp(((s * normalizedRadius) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex);\n          \n          // Precision bug fix: Enforce safe bounds wrapping inside target integers\n          int bx = clamp(int(round(bxRaw)), 0, int(bokehMaxIndex)); \n          int by = clamp(int(round(byRaw)), 0, int(bokehMaxIndex)); \n\n          float4 aperture = bokeh(bx, by); \n          float alphaW = clamp(aperture.w, 0.0f, 1.0f);\n          float weight = clamp(aperture.y, 0.0f, 1.0f) * alphaW; // Primary mono channel map\n          \n          if (weight <= 0.000001f) continue;\n          float4 wV = float4(weight, weight, weight, weight);\n\n          int sx = clamp(int(round(c * currentRadius)), -maxRadiusInt, maxRadiusInt); \n          int sy = clamp(int(round(s * currentRadius)), -maxRadiusInt, maxRadiusInt); \n\n          sumVec += sanitizeVec(src(sx, sy)) * wV; \n          weightVec += wV; \n        \} \n      \} \n    \} else \{ \n      // Complex Pass: Full Custom Dispersion + Chromatic Shift Math\n      for (int r = 1; r <= rings; ++r) \{ \n        float normalizedRadius = sqrt((float(r) - 0.5f) / float(rings)); \n        float currentRadius = radius * normalizedRadius; \n\n        int angularSamples = clamp(int(ceil(TWO_PI * currentRadius)), 8, 512); \n        float invAngularSamples = 1.0f / float(angularSamples); \n        float ringRotation = float(r) * GOLDEN_ANGLE; \n\n        for (int a = 0; a < angularSamples; ++a) \{ \n          float angle = (float(a) + 0.5f) * invAngularSamples * TWO_PI + ringRotation; \n          float c = cos(angle); \n          float s = sin(angle); \n\n          float baseX = c * normalizedRadius; \n          float baseY = s * normalizedRadius; \n\n          // Map shifted texture coordinates smoothly across lookup fields\n          int bxR = clamp(int(round(clamp(( (baseX + c * chromaShiftSafe) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n          int byR = clamp(int(round(clamp(( (baseY + s * chromaShiftSafe) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n          int bxG = clamp(int(round(clamp(( (baseX) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n          int byG = clamp(int(round(clamp(( (baseY) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n          int bxB = clamp(int(round(clamp(( (baseX - c * chromaShiftSafe) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n          int byB = clamp(int(round(clamp(( (baseY - s * chromaShiftSafe) * 0.5f + 0.5f) * bokehMaxIndex, 0.0f, bokehMaxIndex))), 0, int(bokehMaxIndex));\n\n          float4 apR = bokeh(bxR, byR); \n          float4 apG = bokeh(bxG, byG); \n          float4 apB = bokeh(bxB, byB); \n\n          float rawR = clamp(apR.x, 0.0f, 1.0f) * clamp(apR.w, 0.0f, 1.0f); \n          float rawG = clamp(apG.y, 0.0f, 1.0f) * clamp(apG.w, 0.0f, 1.0f); \n          float rawB = clamp(apB.z, 0.0f, 1.0f) * clamp(apB.w, 0.0f, 1.0f); \n\n          float neutral = (rawR + rawG + rawB) * 0.33333333f; \n          float wr = clamp(neutral + (rawR - neutral) * chromaStrengthSafe, 0.0f, 1.0f); \n          float wg = clamp(neutral + (rawG - neutral) * chromaStrengthSafe, 0.0f, 1.0f); \n          float wb = clamp(neutral + (rawB - neutral) * chromaStrengthSafe, 0.0f, 1.0f); \n\n          // Fix alpha weighting equation back to clean uniform geometry\n          float4 wV = float4(wr, wg, wb, wg); \n\n          int sxR = clamp(int(round(baseX * radiusR)), -maxRadiusInt, maxRadiusInt); \n          int syR = clamp(int(round(baseY * radiusR)), -maxRadiusInt, maxRadiusInt); \n          int sxG = clamp(int(round(baseX * radius)),  -maxRadiusInt, maxRadiusInt); \n          int syG = clamp(int(round(baseY * radius)),  -maxRadiusInt, maxRadiusInt); \n          int sxB = clamp(int(round(baseX * radiusB)), -maxRadiusInt, maxRadiusInt); \n          int syB = clamp(int(round(baseY * radiusB)), -maxRadiusInt, maxRadiusInt); \n\n          // Strip individual branch reads down to vectorized operations\n          if (wV.x > 0.000001f) \{ sumVec.x += sanitizeVec(src(sxR, syR)).x * wV.x; weightVec.x += wV.x; \} \n          \n          float4 sG = sanitizeVec(src(sxG, syG));\n          if (wV.y > 0.000001f) \{ sumVec.y += sG.y * wV.y; weightVec.y += wV.y; \} \n          if (wV.w > 0.000001f) \{ sumVec.w += sG.w * wV.w; weightVec.w += wV.w; \} \n          \n          if (wV.z > 0.000001f) \{ sumVec.z += sanitizeVec(src(sxB, syB)).z * wV.z; weightVec.z += wV.z; \} \n        \} \n      \} \n    \} \n\n    dst() = float4(sumVec.x / weightVec.x, sumVec.y / weightVec.y, sumVec.z / weightVec.z, sumVec.w / weightVec.w); \n  \} \n\};\n"
  rebuild ""
  Bokeh_maxRadius {{parent.bk_amount}}
  Bokeh_quality {{parent.bk_samples}}
  Bokeh_chromaStrength {{parent.bk_ca_strength}}
  Bokeh_chromaRadius {{parent.bk_ca_radius}}
  Bokeh_chromaShift {{parent.bk_ca_shift}}
  Bokeh_bokehResolution {{parent.bk_bokeh_resolution}}
  Bokeh_adaptiveQuality {{parent.bk_adaptivequality}}
  rebuild_finalise ""
  name B0keh
  xpos -935
  ypos 695
 }
