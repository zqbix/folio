  KernelDescription "3 \"GaussianBlur\" iterate pixelWise 283063f50df4e14841050555fff6e37f5ea6882e0b2cff593f92f63c24d46cc3 3 \"src\" Read Ranged2D \"mask\" Read Point \"dst\" Write Point 6 \"maxRadius\" Float 1 AAAgQQ== \"maxTaps\" Int 1 BQAAAA== \"chromaStrength\" Float 1 AAAAAA== \"chromaRadius\" Float 1 AAAAAA== \"chromaShift\" Float 1 AAAAAA== \"adaptiveQuality\" Int 1 AAAAAA== 6 \"maxRadius\" 1 1 Default \"maxTaps\" 1 1 Default \"chromaStrength\" 1 1 Default \"chromaRadius\" 1 1 Default \"chromaShift\" 1 1 Default \"adaptiveQuality\" 1 1 Default 7 \"srcrangeMin\" Int 2 1 AAAAAAAAAAA= \"srcrangeMax\" Int 2 1 AAAAAAAAAAA= \"maxRadiusInt\" Int 1 1 AAAAAA== \"maxTapsSafe\" Int 1 1 AAAAAA== \"radiusScaleR\" Float 1 1 AAAAAA== \"radiusScaleB\" Float 1 1 AAAAAA== \"chromaShiftSafe\" Float 1 1 AAAAAA=="
  kernelSource "kernel GaussianBlur : public ImageComputationKernel<ePixelWise>\n\{ \n  // Input / Output Images\n  Image<eRead, eAccessRanged2D, eEdgeClamped> src; \n  Image<eRead, eAccessPoint, eEdgeClamped> mask; \n  Image<eWrite> dst; \n\n  // Public Parameters\n  param:\n    float maxRadius; \n    int maxTaps; \n    float chromaStrength; \n    float chromaRadius; \n    float chromaShift; \n    int adaptiveQuality; \n\n  // Local Variables\n  local:\n    int maxRadiusInt; \n    int maxTapsSafe; \n    float radiusScaleR; \n    float radiusScaleB; \n    float chromaShiftSafe; \n\n  void define() \n  \{ \n    defineParam(maxRadius, \"maxRadius\", 10.0f); \n    defineParam(maxTaps, \"maxTaps\", 5); \n    defineParam(chromaStrength, \"chromaStrength\", 0.0f); \n    defineParam(chromaRadius, \"chromaRadius\", 0.0f); \n    defineParam(chromaShift, \"chromaShift\", 0.0f); \n    defineParam(adaptiveQuality, \"adaptiveQuality\", 0); \n  \} \n\n  void init() \n  \{ \n    float safeRadius = max(maxRadius, 0.0f); \n    float chromaStrengthSafe = clamp(chromaStrength, 0.0f, 4.0f); \n    float chromaRadiusSafe = clamp(chromaRadius * chromaStrengthSafe, -0.5f, 0.5f); \n    chromaShiftSafe = clamp(chromaShift * chromaStrengthSafe, -0.25f, 0.25f); \n\n    radiusScaleR = max(0.01f, 1.0f + chromaRadiusSafe); \n    radiusScaleB = max(0.01f, 1.0f - chromaRadiusSafe); \n\n    // Cap at a safe limit to prevent stack-allocated array overflows in process()\n    maxTapsSafe = clamp(maxTaps, 1, 48); \n\n    float maxRadiusScale = 1.0f + fabs(chromaRadiusSafe) + fabs(chromaShiftSafe); \n    int calculatedRadius = int(ceil(safeRadius * maxRadiusScale)) + 2; \n    \n    maxRadiusInt = max(calculatedRadius, maxTapsSafe); \n    src.setRange(-maxRadiusInt, -maxRadiusInt, maxRadiusInt, maxRadiusInt); \n  \} \n\n  inline float4 sanitizeVec(float4 v) \{\n    if (v.x != v.x || fabs(v.x) > 1.0e30f) v.x = 0.0f;\n    if (v.y != v.y || fabs(v.y) > 1.0e30f) v.y = 0.0f;\n    if (v.z != v.z || fabs(v.z) > 1.0e30f) v.z = 0.0f;\n    if (v.w != v.w || fabs(v.w) > 1.0e30f) v.w = 0.0f;\n    return v;\n  \}\n\n  void process(int2 pos) \n  \{ \n    float m = clamp(mask().x, 0.0f, 1.0f); \n    float radius = max(maxRadius, 0.0f) * m; \n\n    if (radius < 0.5f) \{ \n      dst() = src(0, 0); \n      return; \n    \} \n\n    float sigma = radius * 0.33333333f; \n    float sigmaR = sigma * radiusScaleR; \n    float sigmaB = sigma * radiusScaleB; \n\n    int neededTaps = int(ceil(max(sigmaR, sigmaB) * 3.0f)) + 1; \n    int taps = (adaptiveQuality != 0) ? max(int(round(float(maxTapsSafe) * m)), 1) : maxTapsSafe; \n    taps = clamp(taps, 1, neededTaps); \n\n    int shiftInt = int(round(chromaShiftSafe * radius)); \n\n    float invTwoSigmaR2 = 0.5f / (sigmaR * sigmaR + 1.0e-8f); \n    float invTwoSigmaG2 = 0.5f / (sigma * sigma + 1.0e-8f); \n    float invTwoSigmaB2 = 0.5f / (sigmaB * sigmaB + 1.0e-8f); \n\n    // Allocate 1D lookup buffers on the stack. Safe since maxTapsSafe <= 48.\n    // Indexing math maps loop index \[-48, 48] safely to buffer.\n    float wR_lut\[97];\n    float wG_lut\[97];\n    float wB_lut\[97];\n\n    for (int i = -taps; i <= taps; ++i) \{\n      float f2 = float(i * i);\n      wR_lut\[i + 48] = exp(-f2 * invTwoSigmaR2);\n      wG_lut\[i + 48] = exp(-f2 * invTwoSigmaG2);\n      wB_lut\[i + 48] = exp(-f2 * invTwoSigmaB2);\n    \}\n\n    float sumR = 0.0f, sumG = 0.0f, sumB = 0.0f, sumA = 0.0f; \n    float wR_sum = 0.0f, wG_sum = 0.0f, wB_sum = 0.0f, wA_sum = 0.0f; \n\n    if (shiftInt == 0) \{ \n      for (int dy = -taps; dy <= taps; ++dy) \{ \n        int yIdx = dy + 48;\n        float wRy = wR_lut\[yIdx]; \n        float wGy = wG_lut\[yIdx]; \n        float wBy = wB_lut\[yIdx]; \n\n        for (int dx = -taps; dx <= taps; ++dx) \{ \n          int xIdx = dx + 48;\n          float wR = wRy * wR_lut\[xIdx]; \n          float wG = wGy * wG_lut\[xIdx]; \n          float wB = wBy * wB_lut\[xIdx]; \n\n          float4 s = sanitizeVec(src(dx, dy)); \n\n          sumR += s.x * wR; wR_sum += wR; \n          sumG += s.y * wG; wG_sum += wG; \n          sumB += s.z * wB; wB_sum += wB; \n          sumA += s.w * wG; wA_sum += wG; \n        \} \n      \} \n    \} else \{ \n      for (int dy = -taps; dy <= taps; ++dy) \{ \n        int yIdx = dy + 48;\n        float wRy = wR_lut\[yIdx]; \n        float wGy = wG_lut\[yIdx]; \n        float wBy = wB_lut\[yIdx]; \n\n        for (int dx = -taps; dx <= taps; ++dx) \{ \n          int xIdx = dx + 48;\n          float wR = wRy * wR_lut\[xIdx]; \n          float wG = wGy * wG_lut\[xIdx]; \n          float wB = wBy * wB_lut\[xIdx]; \n\n          int idxR = clamp(dx + shiftInt, -maxRadiusInt, maxRadiusInt);\n          int idxB = clamp(dx - shiftInt, -maxRadiusInt, maxRadiusInt);\n\n          sumR += sanitizeVec(src(idxR, dy)).x * wR; wR_sum += wR; \n          \n          float4 sG = sanitizeVec(src(dx, dy));\n          sumG += sG.y * wG; wG_sum += wG; \n          sumA += sG.w * wG; wA_sum += wG; \n          \n          sumB += sanitizeVec(src(idxB, dy)).z * wB; wB_sum += wB; \n        \} \n      \} \n    \} \n\n    dst() = float4(sumR / wR_sum, sumG / wG_sum, sumB / wB_sum, sumA / wA_sum); \n  \} \n\};\n"
  rebuild ""
