 Group {
  inputs 3
  name _15
  xpos -60
  ypos 64
  disable {{this.switch}}
  addUserKnob {20 User}
  addUserKnob {7 step l "Quality Step"}
  step {{"\[string map \{\"_\" \"\"\} \[value name]]"}}
  addUserKnob {7 min l "Mask Min"}
  min {{input.max}}
  addUserKnob {7 max l "Mask Max"}
  max {{"parent.glo_divisions == 0\n?\nthis.step / parent.glo_quality\n:\npow(this.step / parent.glo_quality, \[string map \{\"^\" \"\"\} \[value parent.glo_divisions]])"}}
  addUserKnob {7 def l Defocus}
  def {{"parent.glo_amount * this.max"}}
  addUserKnob {7 ar l "Aspect Ratio"}
  ar {{parent.bd_ar}}
  addUserKnob {7 switch l Switch}
  switch {{"this.max > 1 ? 1 : 0"}}
 }
  Input {
   inputs 0
   name Depth
   xpos 46
   ypos -232
   number 1
  }
  Grade {
