set cut_paste_input [stack 0]
version 17.1 v1
push $cut_paste_input
Group {
 name zqDepthBlurIterative
 selected true
 xpos -540
 ypos 1139
 addUserKnob {20 zqdepthbluriterative l zqDepthBlurIterative}
 addUserKnob {26 __METHOD l "" +STARTLINE T "<br>\n<b><i>METHOD</i></b>\n<br>"}
 addUserKnob {4 meth_choose l Choose M {Blur Defocus Bokeh ""}}
 addUserKnob {26 __BLUR_DEFOCUS l "" +STARTLINE T "<br>\n<b><i>BLUR DEFOCUS ONLY</i></b>\n<br>"}
 addUserKnob {7 bd_ar l "Aspect Ratio"}
 bd_ar 1
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 glo_amount l Amount}
 glo_amount 10
 addUserKnob {4 glo_quality l Quality M {5 10 15 20}}
 addUserKnob {7 glo_expo l Exponent R 1 5}
 glo_expo 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Depth Blur/Defocus/Bokeh Iterative\n<br><br>\nIterative node-setup, so pretty slow with large blur-amounts..\n<br>\nBokeh method needs <b>zqDepthBokehGenerator</b> or something similar as input!.."}
}
