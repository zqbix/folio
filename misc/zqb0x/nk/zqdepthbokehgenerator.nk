set cut_paste_input [stack 0]
version 17.1 v1
Group {
 inputs 0
 name zqDepthBokehGenerator
 selected true
 xpos -850
 ypos 16950
 addUserKnob {20 zqDepthBokehGenerator l zqdepthbokehgenerator}
 addUserKnob {26 __BASE l "" +STARTLINE T "<br>\n<b><i>BASE</i></b>\n<br>"}
 addUserKnob {4 base_shape l Shape M {Trigon Tetragon Pentagon Hexagon Septagon ""}}
 base_shape Pentagon
 addUserKnob {7 base_resolution l Resolution}
 base_resolution 512
 addUserKnob {26 __SHAPE l "" +STARTLINE T "<br>\n<b><i>SHAPE</i></b>\n<br>"}
 addUserKnob {7 shape_inside l Inside}
 addUserKnob {7 shape_outside l Outside}
 shape_outside 1
 addUserKnob {7 shape_falloff l Falloff}
 shape_falloff 1
 addUserKnob {7 shape_squeeze l Squeeze R 0.5 2}
 shape_squeeze 1
 addUserKnob {7 shape_roundness l Roundness}
 addUserKnob {7 shape_pinch l Pinch}
 shape_pinch 1
 addUserKnob {7 shape_edgeblur l Edgeblur}
 addUserKnob {26 __COLOR_FRINGE l "" +STARTLINE T "<br>\n<b><i>COLOR FRiNGE</i></b>\n<br>"}
 addUserKnob {7 cf_shift l Shift}
 addUserKnob {7 cf_rotate l Rotate}
 addUserKnob {7 cf_scale l Scale}
 cf_scale 1
 addUserKnob {7 cf_skew l Skew}
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 glo_saturation l Saturation}
 glo_saturation 1
 addUserKnob {7 glo_multiply l Multiply}
 glo_multiply 1
 addUserKnob {7 glo_gamma l Gamma}
 glo_gamma 1
 addUserKnob {7 glo_tx l TX}
 addUserKnob {7 glo_ty l TY}
 addUserKnob {7 glo_r l Rotate}
 addUserKnob {7 glo_scale l Scale}
 glo_scale 1
 addUserKnob {4 glo_alpha l Alpha M {"Full White" "Full Black" "Luma Key"}}
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Depth Bokeh Generator\n<br><br>\nTweak, fiddle, edit.."}
}
 Reformat {
  inputs 0
  type "to box"
  box_width {{parent.base_resolution}}
  box_height {{parent.base_resolution}}
  box_fixed true
  resize distort
  black_outside true
  name Reformat48
  xpos -267
  ypos 937
 }
 AdjBBox {
  numpixels {{"parent.base_resolution * 0.2"}}
  name AdjBBox1
  xpos -267
  ypos 961
 }
 Flare {
  position {{"parent.base_resolution * 0.5"} {"parent.base_resolution * 0.5"}}
  radius {0 {radius.2} {"(parent.base_resolution * 0.5) - 10"}}
  size_mult {{"(this.anamorph < 1 ? this.anamorph : 1/this.anamorph)\n*\n(1 - (parent.shape_edgeblur * (1 / parent.base_resolution)))\n*\n(\nparent.cf_scale < 1\n?\n((1- ((abs(parent.cf_shift) * 2) / parent.base_resolution)) * parent.cf_scale) * (1 - abs(parent.cf_skew * 0.5))\n:\n((1- ((abs(parent.cf_shift) * 2) / parent.base_resolution)) / parent.cf_scale) * (1 - abs(parent.cf_skew * 0.5))\n)\n\n\n"}}
  anamorph {{parent.shape_squeeze}}
  inner_color 1e-05
  corners {{"parent.base_shape + 3"}}
  flattening {{"1 - parent.shape_roundness"}}
  sharpness {{parent.shape_pinch}}
  corners_angle 0.01
  name Flare1
  xpos -267
  ypos 985
 }
 Keyer {
  operation "max keyer"
  range {0 0 1 1}
  name Keyer28
  xpos -267
  ypos 1009
 }
 Dot {
  name Dot1
  xpos -233
  ypos 1045
 }
set N98dff80 [stack 0]
 Shuffle2 {
  fromInput1 {
   {0}
   B
  }
  in1 alpha
  fromInput2 {
   {0}
   B
  }
  mappings "4 rgba.alpha 0 0 rgba.red 0 0 rgba.alpha 0 0 rgba.green 0 1 rgba.alpha 0 0 rgba.blue 0 2 rgba.alpha 0 0 rgba.alpha 0 3"
  name Shuffle1
  xpos -377
  ypos 1042
 }
 Blur {
  channels rgba
  size 10
  name Blur2
  xpos -377
  ypos 1066
 }
 Grade {
  channels rgba
  blackpoint 0.05
  whitepoint {{"blackpoint + 0.1"}}
  white_clamp true
  name Grade1
  xpos -377
  ypos 1090
 }
push $N98dff80
 Merge2 {
  inputs 2
  operation under
  bbox B
  name Merge2
  xpos -267
  ypos 1090
 }
 Dot {
  name Dot2
  xpos -233
  ypos 1114
 }
set N98e0400 [stack 0]
 Dot {
  name Dot3
  xpos -343
  ypos 1114
 }
 Blur {
  channels rgba
  size {{"parent.base_resolution * 0.1"}}
  name Blur1
  xpos -377
  ypos 1153
 }
push $N98e0400
 Merge2 {
  inputs 2
  bbox B
  maskChannelInput rgba.alpha
  name Merge1
  xpos -267
  ypos 1147
 }
 Grade {
  black {{parent.shape_inside}}
  white {{parent.shape_outside}}
  gamma {{"max(0.01, parent.shape_falloff)"}}
  white_clamp true
  unpremult rgba.alpha
  name Grade2
  xpos -267
  ypos 1183
 }
 Blur {
  channels rgba
  size {{parent.shape_edgeblur}}
  name Blur3
  xpos -267
  ypos 1219
 }
 GodRays {
  channels {rgba.red rgba.green -rgba.blue rgba.alpha}
  translate {{-parent.cf_shift} {-parent.cf_shift}}
  rotate {{-parent.cf_rotate}}
  scale {{parent.cf_scale}}
  skew {{"clamp(-parent.cf_skew, -1,1)"}}
  center {{"parent.base_resolution * 0.5"} {"parent.base_resolution * 0.5"}}
  steps 16
  name GodRays1
  xpos -267
  ypos 1243
 }
 GodRays {
  channels {-rgba.red rgba.green rgba.blue rgba.alpha}
  translate {{parent.cf_shift} {parent.cf_shift}}
  rotate {{parent.cf_rotate}}
  scale {{"1 / parent.cf_scale"}}
  skew {{"clamp(parent.cf_skew, -1,1)"}}
  center {{"parent.base_resolution * 0.5"} {"parent.base_resolution * 0.5"}}
  steps 16
  name GodRays2
  xpos -267
  ypos 1279
 }
 Saturation {
  saturation {{parent.glo_saturation}}
  unpremult rgba.alpha
  name Saturation1
  xpos -267
  ypos 1315
 }
 Multiply {
  channels rgba
  value {{parent.glo_multiply}}
  unpremult rgba.alpha
  name Multiply1
  xpos -267
  ypos 1351
 }
 Gamma {
  channels rgba
  value {{parent.glo_gamma} {parent.glo_gamma} {parent.glo_gamma} {parent.glo_gamma}}
  unpremult rgba.alpha
  name Gamma1
  xpos -267
  ypos 1387
 }
 Transform {
  translate {{parent.glo_tx} {parent.glo_ty}}
  rotate {{parent.glo_r}}
  scale {{parent.glo_scale}}
  center {256 256}
  filter linear
  black_outside false
  name Transform3
  xpos -267
  ypos 1423
 }
set N9b17900 [stack 0]
 Keyer {
  operation "luminance key"
  name Keyer1
  xpos -157
  ypos 1483
 }
push $N9b17900
 Shuffle2 {
  fromInput1 {
   {0}
   B
  }
  in1 none
  out1 alpha
  fromInput2 {
   {0}
   B
  }
  mappings "1 black -1 -1 rgba.alpha 0 0"
  name Shuffle3
  xpos -267
  ypos 1489
 }
push $N9b17900
 Shuffle2 {
  fromInput1 {
   {0}
   B
  }
  in1 none
  out1 alpha
  fromInput2 {
   {0}
   B
  }
  mappings "1 white -1 -1 rgba.alpha 0 0"
  name Shuffle2
  xpos -377
  ypos 1489
 }
 Switch {
  inputs 3
  which {{parent.glo_alpha}}
  name Switch1
  xpos -267
  ypos 1556
 }
 Reformat {
  type "to box"
  box_width {{parent.base_resolution}}
  box_height {{parent.base_resolution}}
  box_fixed true
  resize distort
  black_outside true
  name Reformat1
  xpos -267
  ypos 1608
 }
 Output {
  name Output
  xpos -267
  ypos 1662
 }
end_group
