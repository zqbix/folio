set cut_paste_input [stack 0]
version 17.1 v1
push $cut_paste_input
Group {
 name zqEdgeExtend
 selected true
 xpos 2259
 ypos 3792
 addUserKnob {20 zqedgeextend l zqEdgeExtend}
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 glo_size l Size R 0 100}
 glo_size 50
 addUserKnob {4 glo_quality l Quality M {5 10 15 20}}
 addUserKnob {7 glo_expo l Exponent R 1 5}
 glo_expo 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Edge Extend\n<br><br>\nPremultiplied RGBA has to be provided.."}
}
 Input {
  inputs 0
  name Image
  xpos 1890
  ypos -314
 }
set Nb05c4400 [stack 0]
 Group {
  name _0
  xpos 2179
  ypos -659
  disable {{this.switch}}
  addUserKnob {20 User}
  addUserKnob {7 step l "Quality Step"}
  addUserKnob {7 x l X}
  addUserKnob {7 blur l Blur}
  addUserKnob {7 switch l Switch}
 }
  Input {
