   xpos -314
   ypos 170
  }
 end_group
push $Nb05c4400
 Group {
  inputs 2
  name _1
  xpos 2179
  ypos -625
  addUserKnob {20 User}
  addUserKnob {7 step l "Quality Step"}
  step {{"\[string map \{\"_\" \"\"\} \[value name]]"}}
  addUserKnob {7 x l X}
  x {{"pow(this.step / \[value parent.glo_quality], max(1, parent.glo_expo))"}}
  addUserKnob {7 blur l Blur}
  blur {{"max(1, parent.glo_size * this.x)"}}
  addUserKnob {7 switch l Switch}
  switch {{"this.step > \[value parent.glo_quality] ? 1 : 0"}}
 }
  Input {
   inputs 0
   name Image
   xpos -152
   ypos -5
   number 1
  }
  Dot {
   name Dot1
   xpos -118
   ypos 64
  }
