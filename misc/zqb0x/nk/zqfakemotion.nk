set cut_paste_input [stack 0]
version 17.1 v1
push $cut_paste_input
Group {
 name zqFakeMotion
 selected true
 xpos 67
 ypos 2703
 addUserKnob {20 User l zqFakeMotion}
 addUserKnob {26 __BASE_LAYER l "" +STARTLINE T "<br>\n<b><i>BASE LAYER</i></b>\n<br>"}
 addUserKnob {7 bl_blur l Blur}
 bl_blur 100
 addUserKnob {7 bl_multiply l Multiply}
 bl_multiply 1
 addUserKnob {7 bl_gamma l Gamma}
 bl_gamma 1
 addUserKnob {26 __DETAIL_LAYER l "" +STARTLINE T "<br>\n<b><i>DETAiL LAYER</i></b>\n<br>"}
 addUserKnob {7 dl_blur l Blur}
 dl_blur 30
 addUserKnob {7 dl_erode l Erode}
 dl_erode 100
 addUserKnob {7 dl_sharpen_size l "Sharpen Size"}
 dl_sharpen_size 10
 addUserKnob {7 dl_sharpen_amount l "Sharpen Amount"}
 dl_sharpen_amount 100
 addUserKnob {7 dl_laplacian l Laplacian}
 dl_laplacian 100
 addUserKnob {7 dl_multiply l Multiply}
 dl_multiply 1
 addUserKnob {7 dl_gamma l Gamma}
 dl_gamma 1
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 global_effect_amount l "Effect Amount"}
 global_effect_amount 100
 addUserKnob {7 global_vector_blur l "Vector Blur"}
 global_vector_blur 10
 addUserKnob {12 global_main_direction l "Center/Main Direction"}
 addUserKnob {4 global_output l Output M {"Full Effect" "Base Layer" "Detail Layer" "Merged Layers" ""}}
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Fake Motion\n<br><br>\nTweak the layers and check the full effect..\n<br>\nSet \"Center/Main Direction\" to get proper aligned vectors.."}
}
