 }
 Expression {
  temp_name0 falloff
  temp_expr0 "clamp((1 - abs(x - centerx) / (x < centerx ? centerx : width - centerx)) * (1 - abs(y - centery) / (y < centery ? centery : height - centery)))\n"
  expr0 r*falloff
  expr1 g*falloff
  expr2 b*falloff
  expr3 a*falloff
  name MAIN_DIRECTION
  xpos -225
  ypos 979
  addUserKnob {20 fo l Falloff}
  addUserKnob {7 centerx l "Center X"}
  centerx {{parent.global_main_direction.x}}
  addUserKnob {7 centery l "Center Y"}
  centery {{parent.global_main_direction.y}}
 }
 Expression {
  temp_name0 left
  temp_expr0 r(x-1,y)
  temp_name1 right
  temp_expr1 r(x+1,y)
  temp_name2 up
  temp_expr2 r(x,y-1)
  temp_name3 down
  temp_expr3 r(x,y+1)
  expr0 "a * (left - right)"
  expr1 "a * (up - down)"
  expr2 0
  expr3 0
  name NORMAL
  xpos -225
  ypos 1003
 }
 Expression {
  expr0 -g(x,y)
  expr1 r(x,y)
  expr2 0
  expr3 0
  maskChannelMask none
  name TANGENT
  xpos -225
  ypos 1027
 }
 Expression {
  temp_name0 normalize
  temp_expr0 "max(0.00001, sqrt((r*r) + (g*g) + (b*b)))"
  expr0 "r / normalize"
  expr1 "g / normalize"
  expr2 "b / normalize"
  expr3 "a / normalize"
  name NORMALIZE
  xpos -225
  ypos 1051
 }
 Blur {
