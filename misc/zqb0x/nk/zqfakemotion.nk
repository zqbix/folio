  name Blur25
  xpos -225
  ypos 1094
 }
 Grade {
  inputs 1+1
  multiply 0
  invert_mask true
  mix {{"(\[exists parent.input1] == 0) ? 0 : 1"}}
  name Grade1
  xpos -225
  ypos 1124
 }
