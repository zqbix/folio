 Group {
  inputs 2
  name _1
  xpos -60
  ypos -372
  disable {{this.switch}}
  addUserKnob {20 User}
  addUserKnob {7 step l "Quality Step"}
  step {{"\[string map \{\"_\" \"\"\} \[value name]]"}}
  addUserKnob {7 blur l Blur}
  blur {{"parent.glo_maxsize * this.step / \[value parent.glo_quality]"}}
  addUserKnob {7 mult l Multiply}
  mult {{"pow(1-((this.step-1)/\[value parent.glo_quality]), max(1, parent.glo_expo)) > 0.5\n?\npow(1-((this.step-1)/\[value parent.glo_quality]), max(1, parent.glo_expo)) * max(0.0001, parent.glo_contrast)\n:\npow(1-((this.step-1)/\[value parent.glo_quality]), max(1, parent.glo_expo)) / max(0.0001, parent.glo_contrast)"}}
  addUserKnob {7 switch l Switch}
  switch {{"this.step > \[value parent.glo_quality] ? 1 : 0"}}
 }
  Input {
   inputs 0
   name Base
   xpos -87
   ypos -23
   number 1
  }
  Blur {
   channels rgba
   size {{parent.blur}}
   name Blur32
   xpos -87
   ypos 29
  }
