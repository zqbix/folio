set cut_paste_input [stack 0]
version 17.1 v1
push $cut_paste_input
Group {
 name zqGlow
 selected true
 xpos 2794
 ypos 8745
 addUserKnob {20 zqglow l zqGlow}
 addUserKnob {26 __BASE l "" +STARTLINE T "<br>\n<b><i>BASE</i></b>\n<br>"}
 addUserKnob {7 base_keymin l "Key Min"}
 addUserKnob {7 base_keymax l "Key Max"}
 base_keymax 1
 addUserKnob {7 base_mixog l "Mix Original"}
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {41 operation l Merge T Merge1.operation}
 addUserKnob {7 glo_maxsize l "Max Size"}
 glo_maxsize 100
 addUserKnob {4 glo_quality l Quality M {5 10 15 20 ""}}
 glo_quality 10
 addUserKnob {7 glo_expo l Exponent R 1 5}
 glo_expo 1
 addUserKnob {7 glo_contrast l Contrast R 1 2}
 glo_contrast 1
 addUserKnob {7 glo_blur l Blur}
 addUserKnob {7 glo_saturation l Saturation}
 glo_saturation 1
 addUserKnob {7 glo_intensity l Intensity}
 glo_intensity 1
 addUserKnob {4 glo_output l Output M {Merged "Glow Only" Base ""}}
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Glow\n<br><br>\nTweak.."}
}
 Input {
  inputs 0
  name Image
  xpos -60
  ypos -591
 }
 Dot {
  name Dot1
  xpos -26
  ypos -544
 }
