  temp_expr1 "(a(x,y-1)) - (a(x,y+1))"
  temp_name2 normalize
  temp_expr2 "max(0.00001, hypot(newR, newG))"
  expr0 "newR / normalize * a"
  expr1 "newG / normalize * a"
  expr2 0
  expr3 0
  name calc_normal
  xpos 187
  ypos 666
 }
