 clr_r 1
 addUserKnob {7 clr_g l G}
 clr_g 0.2
 addUserKnob {7 clr_b l B}
 clr_b 0.1
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 g_intensity l Intensity}
 g_intensity 1
 addUserKnob {4 g_output l Output M {"Effect Only" "Full Image" "" "" ""}}
 addUserKnob {6 g_usemask l "Use connected mask" -STARTLINE}
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Halation\n<br><br>\nTweak.."}
}
