set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name zqHalation
 selected true
 xpos 4347
 ypos 13995
 addUserKnob {20 zqhalation l zqHalation}
 addUserKnob {26 __KEY l "" +STARTLINE T "<br>\n<b><i>KEY</i></b>\n<br>"}
 addUserKnob {7 key_min l Min}
 key_min 0.5
