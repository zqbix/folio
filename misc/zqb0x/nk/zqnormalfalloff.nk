set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name zqNormalFalloff
 selected true
 xpos 4859
 ypos 14007
 addUserKnob {20 zqnormalfalloff l zqNormalFalloff}
 addUserKnob {26 __METHOD l "" +STARTLINE T "<br>\n<b><i>METHOD</i></bI\n<br>"}
 addUserKnob {4 method l by M {"Pixel Pick" "Color Sample" "" "" "" "" "" "" ""}}
 addUserKnob {41 normals l "&nbsp;the Normals&nbsp;" -STARTLINE T Shuffle1.in1}
 addUserKnob {26 __PICK l "" +STARTLINE T "<br>\n<b><i>PiCK</i></bI\n<br>"}
 addUserKnob {12 pickNormal l Pixel}
 addUserKnob {26 __SAMPLE l "" +STARTLINE T "<br>\n<b><i>SAMPLE</i></bI\n<br>"}
 addUserKnob {18 sampleNormal l Color}
 sampleNormal {0 0 0}
 addUserKnob {6 sampleNormal_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 g_multiply l Multiply}
 g_multiply 1
 addUserKnob {7 g_gamma l Gamma}
 g_gamma 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Normal Falloff\n<br><br>\nChoose method/normals and adjust accordingly.."}
}
 Input {
  inputs 0
  name N
  xpos -306
  ypos 538
 }
