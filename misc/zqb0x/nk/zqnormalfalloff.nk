 }
set N7ff8f600 [stack 0]
 Dot {
  name Dot5
  xpos -195
  ypos 602
 }
 Expression {
  temp_name0 nx
  temp_expr0 "\[value normals].red * sampleNormal.r"
  temp_name1 ny
  temp_expr1 "\[value normals].green * sampleNormal.g"
  temp_name2 nz
  temp_expr2 "\[value normals].blue * sampleNormal.b"
  temp_name3 nd
  temp_expr3 "clamp(nx + ny + nz, 0, 1)"
  channel0 {rgba.red -rgba.green -rgba.blue -rgba.alpha}
  expr0 nd
  channel1 {-rgba.red rgba.green -rgba.blue none}
  expr1 nd
  channel2 {-rgba.red -rgba.green rgba.blue none}
  expr2 nd
  expr3 nd
  name Expression1
  xpos -229
  ypos 642
 }
