set cut_paste_input [stack 0]
version 17.1 v2
push $cut_paste_input
Group {
 name zqSpot
 knobChanged "\nwith nuke.thisNode():\n    roto = nuke.toNode(\"RotoMain\")\n    if roto:\n        roto\['curves'].fromScript(roto\['curves'].toScript())\n"
