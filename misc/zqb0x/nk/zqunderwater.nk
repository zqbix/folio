  whitepoint {{parent.z_max}}
  name Grade64
  xpos 466
  ypos 651
 }
 Dot {
  name Dot248
  xpos 500
  ypos 742
 }
set N905df80 [stack 0]
 Dot {
  name Dot249
  xpos 500
  ypos 789
 }
 Grade {
  channels alpha
  black {{"clamp(parent.fog_dist, 0, 1)"}}
  name Grade68
  xpos 351
  ypos 780
 }
push $N905df80
 Grade {
  channels alpha
  black {{"clamp(parent.fo_dist, 0, 1)"}}
  name Grade67
  xpos 349
  ypos 733
 }
push $N905d680
 Dot {
  name Dot2
  xpos 221
  ypos 560
 }
 Grade {
  blackpoint {{parent.pre_black}}
  whitepoint {{parent.pre_white}}
  gamma {{"max(0.0001, parent.pre_gamma)"}}
  name Grade66
  xpos 187
  ypos 628
 }
 Grade {
  inputs 1+1
  multiply {{parent.fo_clr.r} {parent.fo_clr.g} {parent.fo_clr.b} 1}
  mix {{"clamp(parent.fo_mix, 0, 1)"}}
  name Grade57
  xpos 187
  ypos 739
 }
 Grade {
  inputs 1+1
  multiply 0
  add {{parent.fog_clr.r} {parent.fog_clr.g} {parent.fog_clr.b} 0}
  mix {{"clamp(parent.fog_mix, 0, 1)"}}
  name Grade69
  xpos 187
  ypos 786
 }
 Dot {
  name Dot3
  xpos 221
  ypos 874
 }
set N905ed00 [stack 0]
 Noise {
  output alpha
  replace true
  size {{parent.schmutz_size.w} {parent.schmutz_size.h}}
  zoffset {{parent.schmutz_z}}
  octaves 2
  gain {{"max(0.0001, parent.schmutz_gain)"}}
  gamma {{"max(0.0001, parent.schmutz_gamma)"}}
  center {1376 768}
  name Noise1
  xpos 350
  ypos 865
 }
 Expression {
  temp_name0 newR
  temp_expr0 "(a(x-1,y)) - (a(x+1,y))"
  temp_name1 newG
  temp_expr1 "(a(x,y-1)) - (a(x,y+1))"
  temp_name2 normalize
  temp_expr2 "max(0.00001, hypot(newR, newG))"
  expr0 "newR / normalize * a"
  expr1 "newG / normalize * a"
  expr2 a
  expr3 a
  name calc_normal
  xpos 350
  ypos 901
 }
 Blur {
  channels rgb
  size {{parent.schmutz_blur}}
  name Blur3
  xpos 350
  ypos 925
 }
set N91bcd00 [stack 0]
 Expression {
  temp_name0 len
  temp_expr0 "max(0.0001, sqrt(r*r + g*g + b*b))"
  expr0 0
  expr1 0
  expr2 0
  expr3 len
  name Expression2
  xpos 350
  ypos 973
 }
push $N91bcd00
push $N905ed00
add_layer {DISTORT DISTORT.red DISTORT.green DISTORT.blue}
 Shuffle2 {
  inputs 2
  fromInput1 {
   {1}
   B
   A
  }
  in1 rgb
  out1 DISTORT
  fromInput2 {
   {0}
   B
   A
  }
  mappings "3 rgba.red 0 0 DISTORT.red 0 0 rgba.green 0 1 DISTORT.green 0 1 rgba.blue 0 2 DISTORT.blue 0 2"
  name Shuffle1
  xpos 187
  ypos 925
 }
 IDistort {
  channels rgba
  uv DISTORT
  uv_scale {{parent.schmutz_intensity}}
  blur_scale 0
  name IDistort1
  xpos 187
  ypos 949
 }
 Grade {
  inputs 1+1
  blackpoint {{parent.schmutz_g_black}}
  whitepoint {{parent.schmutz_g_white}}
  gamma {{"max(0.0001, parent.schmutz_g_gamma)"}}
  name Grade2
  xpos 187
  ypos 973
 }
 Output {
  name Output
  xpos 187
  ypos 1060
 }
end_group
