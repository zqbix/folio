set cut_paste_input [stack 0]
version 17.1 v3
push $cut_paste_input
Group {
 name zqUnderwater
 selected true
 xpos 1381
 ypos 18373
 addUserKnob {20 zqunderwater l zqUnderwater}
 addUserKnob {26 __DEPTH l "" +STARTLINE T "<br>\n<b><i>DEPTH</i></b>\n<br>"}
 addUserKnob {41 from0 l Depth T Copy1.from0}
 addUserKnob {7 z_min l Min}
 addUserKnob {7 z_max l Max}
 z_max 1
 addUserKnob {26 __PREGRADE l "" +STARTLINE T "<br>\n<b><i>PRE-GRADE</i></b>\n<br>"}
 addUserKnob {7 pre_black l Blackpoint R -1 1}
 addUserKnob {7 pre_white l Whitepoint R 0 2}
 pre_white 1
 addUserKnob {7 pre_gamma l Gamma R 0 2}
 pre_gamma 1
 addUserKnob {26 __FALLOFF l "" +STARTLINE T "<br>\n<b><i>FALLOFF</i></b>\n<br>"}
 addUserKnob {18 fo_clr l Color}
 fo_clr {0.3999999762 0.5320000052 1}
 addUserKnob {6 fo_clr_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 fo_dist l Distance}
 addUserKnob {7 fo_mix l Mix}
 addUserKnob {26 __FOG l "" +STARTLINE T "<br>\n<b><i>FOG</i></b>\n<br>"}
 addUserKnob {18 fog_clr l Color}
 fog_clr {0.1800000072 0.3000000119 0.2567999959}
 addUserKnob {6 fog_clr_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 fog_dist l Distance}
 addUserKnob {7 fog_mix l Mix}
 addUserKnob {26 __SCHMUTZ_NOISE l "" +STARTLINE T "<br>\n<b><i>SCHMUTZ NOiSE</i></b>\n<br>"}
 addUserKnob {14 schmutz_size l Size R 0 100}
 schmutz_size {500 100}
 addUserKnob {7 schmutz_z l Animate}
 addUserKnob {7 schmutz_gain l Gain}
 schmutz_gain 0.5
 addUserKnob {7 schmutz_gamma l Gamma}
 schmutz_gamma 0.5
 addUserKnob {7 schmutz_blur l Blur}
 schmutz_blur 50
 addUserKnob {7 schmutz_intensity l Intensity}
 addUserKnob {26 __SCHMUTZ_GRADE l "" +STARTLINE T "<br>\n<b><i>SCHMUTZ GRADE</i></b>\n<br>"}
 addUserKnob {7 schmutz_g_black l Blackpoint R -1 1}
 addUserKnob {7 schmutz_g_white l Whitepoint R 0 2}
 schmutz_g_white 1
 addUserKnob {7 schmutz_g_gamma l Gamma R 0 2}
 schmutz_g_gamma 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Underwater\n<br><br>\nUnderwater look/feel based on z-depth..\n<br>\nTweak from top to bottom and you should be fine.."}
}
 Input {
  inputs 0
  name Image
  xpos 331
  ypos 502
 }
 Dot {
  name Dot1
  xpos 365
  ypos 560
 }
set N905d680 [stack 0]
 Dot {
  name Dot4
  xpos 500
  ypos 560
 }
set N905db00 [stack 0]
push $N905db00
 Copy {
  inputs 2
  from0 depth.Z
  to0 rgba.alpha
  name Copy1
  xpos 466
  ypos 591
 }
 Expression {
  expr0 0
  expr1 0
  expr2 0
  name Expression1
  xpos 466
  ypos 627
 }
 Grade {
