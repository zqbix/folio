set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name zqVanishingPointGuide
 selected true
 xpos 5122
 ypos 14012
 addUserKnob {20 zqvanishingpointguide l zqVanishingPointGuide}
 addUserKnob {26 __VANISHING_POINT l "" +STARTLINE T "<br>\n<b><i>VANiSHiNG POiNT</i></b>\n<br>"}
 addUserKnob {12 vanpoixy l Pick}
 vanpoixy {947 945}
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</i></b>\n<br>"}
 addUserKnob {7 numberoflines l Lines}
 numberoflines 24
 addUserKnob {7 thr l Threshold}
 thr 0.99
 addUserKnob {7 foff l Falloff}
 foff 0.5
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Vanishing Point Guide\n<br><br>\nPick vanishing point and adjust globals.."}
}
 Input {
  inputs 0
  name Image
  xpos -267
  ypos 644
 }
 Expression {
  temp_name0 vpGuide
  temp_expr0 "(abs(sin(atan2((y - vpxy.y), (x - vpxy.x)) * numlines)) > threshold) * (1 / (sqrt(pow((x - vpxy.x), 2) + pow((y - vpxy.y), 2)) / (width * falloff) + 1))"
  expr0 vpGuide
  expr1 "g * 0.5"
  expr2 "b * 0.5"
  name Expression
  xpos -267
  ypos 686
  addUserKnob {20 User}
  addUserKnob {12 vpxy l "vanishingPoint x/y"}
  vpxy {{vanpoixy.x} {vanpoixy.y}}
  addUserKnob {7 numlines l numLines R 8 40}
  numlines {{numberoflines}}
  addUserKnob {7 threshold R 0.6 0.99}
  threshold {{thr}}
  addUserKnob {7 falloff R 0.5 2}
  falloff {{foff}}
 }
 Output {
  name Output
  xpos -267
  ypos 730
 }
end_group
