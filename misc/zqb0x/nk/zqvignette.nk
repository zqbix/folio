set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name zqVignette
 selected true
 xpos 5242
 ypos 14013
 addUserKnob {20 zqVignette}
 addUserKnob {26 __SHAPE l "" +STARTLINE T "<br>\n<b><i>SHAPE</i></b>\n<br>"}
 addUserKnob {7 shape_width l Width}
 shape_width 1
 addUserKnob {7 shape_height l Height}
 shape_height 1
 addUserKnob {7 shape_falloff l Falloff}
 shape_falloff 1
 addUserKnob {26 __COLOR l "" +STARTLINE T "<br>\n<b><i>COLOR</i></b>\n<br>"}
 addUserKnob {7 clr_multiply l Multiply}
 clr_multiply 1
 addUserKnob {7 clr_gamma l Gamma}
 clr_gamma 1
 addUserKnob {7 clr_saturation l Saturation}
 clr_saturation 1
 addUserKnob {26 __ABERRATION l "" +STARTLINE T "<br>\n<b><i>ABERRATiON</i></b>\n<br>"}
 addUserKnob {7 aber_amount l Amount}
 addUserKnob {7 aber_steps l Steps}
 aber_steps 5
 addUserKnob {26 __BLUR l "" +STARTLINE T "<br>\n<b><i>BLUR</i></b>\n<br>"}
 addUserKnob {7 b_size l Size}
 addUserKnob {7 b_mix l Mix}
 b_mix 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</i></b> - Vignette\n<br><br>\nTweak and adjust.."}
}
 Input {
  inputs 0
  name Image
  xpos 187
  ypos 493
 }
 ModifyMetaData {
  metadata {
   {set zqVignette/height "\[value input.height]"}
   {set zqVignette/width "\[value input.width]"}
  }
  name ModifyMetaData1
  xpos 187
  ypos 547
 }
 Dot {
  name Dot113
  xpos 221
  ypos 598
 }
set N80110d00 [stack 0]
 Dot {
  name Dot3
  xpos 341
  ypos 598
 }
 Radial {
  replace true
  invert true
  area {0 0 {"\[metadata zqVignette/width]"} {"\[metadata zqVignette/height]"}}
  name Radial2
  xpos 307
  ypos 632
 }
 Transform {
  scale {{parent.shape_width} {parent.shape_height}}
  center {{"\[metadata zqVignette/width] * 0.5"} {"\[metadata zqVignette/height] * 0.5"}}
  black_outside false
  name Transform3
  xpos 306
  ypos 657
 }
 Crop {
  box {0 0 {"\[metadata zqVignette/width]"} {"\[metadata zqVignette/height]"}}
  reformat true
  crop false
  name Crop8
  xpos 306
  ypos 681
 }
 Gamma {
  channels rgba
  value {{parent.shape_falloff} {parent.shape_falloff} {parent.shape_falloff} {parent.shape_falloff}}
  name Gamma2
  xpos 306
  ypos 705
 }
 Dot {
  name Dot117
  xpos 340
  ypos 756
 }
set N80111600 [stack 0]
 Dot {
  name Dot118
  xpos 340
  ypos 780
 }
set N80111a80 [stack 0]
 Dot {
  name Dot1
  xpos 340
  ypos 804
 }
set N80244000 [stack 0]
 Dot {
  name Dot2
  xpos 340
  ypos 868
 }
set N80244480 [stack 0]
 Dot {
  name Dot4
  xpos 340
  ypos 904
 }
set N80244900 [stack 0]
 Dot {
  name Dot5
  xpos 340
  ypos 1007
 }
push $N80244900
push $N80244480
push $N80244000
push $N80111a80
push $N80111600
push $N80110d00
 Multiply {
  inputs 1+1
  channels rgb
  value {{parent.clr_multiply} {parent.clr_multiply} {parent.clr_multiply} 1}
  name Multiply1
  xpos 187
  ypos 753
 }
 Gamma {
  inputs 1+1
  channels rgb
  value {{parent.clr_gamma} {parent.clr_gamma} {parent.clr_gamma} 1}
  name Gamma1
  xpos 187
  ypos 777
 }
 Saturation {
  inputs 1+1
  saturation {{parent.clr_saturation}}
  name Saturation5
  xpos 187
  ypos 801
 }
 GodRays {
  inputs 1+1
  channels {rgba.red rgba.green -rgba.blue none}
  scale {{"1 + clamp(parent.aber_amount, 0, 1)"}}
  center {{"\[metadata zqVignette/width] * 0.5"} {"\[metadata zqVignette/height] * 0.5"}}
  steps {{parent.aber_steps}}
  name GodRays1
  xpos 187
  ypos 865
 }
 GodRays {
  inputs 1+1
  channels {-rgba.red rgba.green rgba.blue none}
  scale {{"1 - clamp(parent.aber_amount, 0, 1)"}}
  center {{"\[metadata zqVignette/width] * 0.5"} {"\[metadata zqVignette/height] * 0.5"}}
  steps {{parent.aber_steps}}
  name GodRays2
  xpos 187
  ypos 901
 }
 Crop {
  box {0 0 {"\[metadata zqVignette/width]"} {"\[metadata zqVignette/height]"}}
  reformat true
  crop false
  name Crop1
  xpos 187
  ypos 937
 }
 Blur {
  inputs 1+1
  channels rgb
  size {{parent.b_size}}
  mix {{parent.b_mix}}
  name Blur1
  xpos 187
  ypos 1004
 }
 ModifyMetaData {
  metadata {
   {remove zqVignette/height ""}
   {remove zqVignette/width ""}
  }
  name ModifyMetaData2
  xpos 187
  ypos 1068
 }
 Output {
  name Output
  xpos 187
  ypos 1126
 }
end_group
