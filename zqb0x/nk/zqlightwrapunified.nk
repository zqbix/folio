set cut_paste_input [stack 0]
version 17.0 v4
push $cut_paste_input
Group {
 name zqLightwrapUnified
 selected true
 xpos 4605
 ypos 14001
 addUserKnob {20 zqlightwrapunified l zqLightwrapUnified}
 addUserKnob {26 __BACKGROUND l "" +STARTLINE T "<br>\n<b><i>BACKGROUND</b></i>\n<br>"}
 addUserKnob {7 bg_blur l Blur}
 bg_blur 300
 addUserKnob {26 __GLOBAL l "" +STARTLINE T "<br>\n<b><i>GLOBAL</b></i>\n<br>"}
 addUserKnob {7 g_size l Size}
 g_size 100
 addUserKnob {7 g_mult l Multiply}
 g_mult 1
 addUserKnob {7 g_gamma l Gamma}
 g_gamma 1
 addUserKnob {7 g_saturation l Saturation}
 g_saturation 1
 addUserKnob {26 __zqb0x l "" +STARTLINE T "<br><br><br>\n<b><i>zqb0x</b></i> - Lightwrap Unified\n<br><br>\nTweak.."}
}
 Input {
  inputs 0
  name FG
  xpos 315
  ypos 542
 }
 Dot {
  name Dot105
  xpos 349
  ypos 633
 }
 Input {
  inputs 0
  name BG
  xpos 535
  ypos 545
  number 1
 }
 Dot {
  name Dot1
  xpos 569
  ypos 633
 }
add_layer {FG_ALPHA FG_ALPHA.red FG_ALPHA.green FG_ALPHA.blue FG_ALPHA.alpha}
 Shuffle2 {
  inputs 2
  fromInput1 {
   {1}
   B
   A
  }
  in1 alpha
  out1 FG_ALPHA
  fromInput2 {
   {0}
   B
   A
  }
  mappings "4 rgba.alpha 0 0 FG_ALPHA.red 0 0 rgba.alpha 0 0 FG_ALPHA.green 0 1 rgba.alpha 0 0 FG_ALPHA.blue 0 2 rgba.alpha 0 0 FG_ALPHA.alpha 0 3"
  name Shuffle35
  xpos 424
  ypos 630
 }
 Blur {
  channels rgb
  size {{parent.bg_blur} {parent.bg_blur}}
  name Blur24
  xpos 424
  ypos 692
 }
 Grade {
  channels rgba
  multiply 0
  maskChannelInput FG_ALPHA.alpha
  name Grade106
  xpos 424
  ypos 751
 }
 Blur {
  channels rgba
  size {{parent.g_size} {parent.g_size}}
  name Blur25
  xpos 424
  ypos 787
 }
 Grade {
  channels rgba
  multiply 0
  maskChannelInput FG_ALPHA.alpha
  invert_mask true
  name Grade107
  xpos 424
  ypos 811
 }
 Multiply {
  channels rgba
  value {{parent.g_mult} {parent.g_mult} {parent.g_mult} {parent.g_mult}}
  name Multiply4
  xpos 424
  ypos 924
 }
 Gamma {
  channels rgba
  value {{parent.g_gamma} {parent.g_gamma} {parent.g_gamma} {parent.g_gamma}}
  name Gamma4
  xpos 424
  ypos 948
 }
 Saturation {
  saturation {{parent.g_saturation}}
  name Saturation1
